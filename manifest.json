{
  "manifest_version": 3,
  "name": "Jobinzy",
  "version": "0.1.0",
  "description": "Autofill job application forms from your saved profile and draft open-ended answers with AI.",
  "action": {
    "default_title": "Jobinzy — Detect Form",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "options_page": "src/ui/options.html",
  "permissions": ["storage", "activeTab", "scripting"]
}
